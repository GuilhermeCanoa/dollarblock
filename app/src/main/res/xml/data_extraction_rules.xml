<?xml version="1.0" encoding="utf-8"?>
<!-- Sigilo bancário (Android 12+): nada do DollarBlock vai para o backup em nuvem do
     Google — uso, limites e recibos ficam só no aparelho. A transferência direta para
     um celular novo (cabo/Wi-Fi, iniciada pelo usuário) continua permitida. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
